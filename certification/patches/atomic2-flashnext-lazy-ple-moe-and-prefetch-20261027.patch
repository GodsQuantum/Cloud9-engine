diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 6f89eb1c..4fc1837a 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1702,7 +1702,20 @@ bool llama_model_base::load_tensors(llama_model_loader & ml) {
         }
     }
 
-    ml.init_mappings(true, use_mlock ? &pimpl->mlock_mmaps : nullptr);
+    // Qwen4Exp Flash-Next's on-disk 35.76 GiB PLE and 47.17 GiB CPU
+    // expert pool are explicitly demand-paged by the caller. Respect the
+    // same policy during mmap setup: a global WILLNEED preload of the
+    // remaining tensors can stall a busy 96-GiB shared-memory host.
+    // Only applies with an explicit --tensor-read-lazy on and mmap mode;
+    // no change to existing default/load semantics or other architectures.
+    const bool qwen4exp_demand_paged =
+        arch == LLM_ARCH_QWEN4EXP &&
+        ml.tensor_read_lazy == LLAMA_TENSOR_READ_LAZY_ON &&
+        load_mode == LLAMA_LOAD_MODE_MMAP;
+    if (qwen4exp_demand_paged) {
+        LLAMA_LOG_INFO("%s: Qwen4Exp on-demand mmap: skipping eager weight prefetch\n", __func__);
+    }
+    ml.init_mappings(!qwen4exp_demand_paged, use_mlock ? &pimpl->mlock_mmaps : nullptr);
     pimpl->mappings.reserve(ml.mappings.size());
 
     // create the backend buffers
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 7283a5a9..ad759b1c 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -196,8 +196,12 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
             ple_rows = ple_w->tensor->ne[1];
         }
 
+        // Match Gemma4's native tensor-read-lazy handling. Flash-Next AD4.27
+        // carries a 35.76 GiB PLE/n-gram table whose selected rows alone are
+        // needed for each token; mmap keeps the table on NVMe instead of
+        // prefetching all 35.76 GiB and stalling the host.
         per_layer_tok_embd = create_tensor(tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight"),
-                                           { hparams.ple_head_dim, ple_rows }, 0);
+                                           { hparams.ple_head_dim, ple_rows }, TENSOR_READ_LAZY);
     }
 
     // MTP tensors sit in the trailing blocks; skip them entirely unless a draft head was asked for
@@ -266,8 +270,13 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
         }
 
         layer.ffn_gate_inp  = create_tensor(tn(LLM_TENSOR_FFN_GATE_INP,  "weight", il), { n_embd, n_expert }, flags);
-        layer.ffn_down_exps = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", il), { n_ff_exp, n_embd, n_expert }, flags);
-        create_tensor_gate_up_exps(layer, il, n_embd, n_ff_exp, n_expert, flags);
+        // Flash-Next AD4.27 routed experts take 47.17 GiB in 144 tensors.
+        // With CPU MoE + --tensor-read-lazy on, do not MADV_WILLNEED the
+        // *whole* expert pool at startup: only 10/512 experts per layer
+        // participate in each decode. This is native mmap demand paging.
+        const int expert_flags = flags | TENSOR_READ_LAZY;
+        layer.ffn_down_exps = create_tensor(tn(LLM_TENSOR_FFN_DOWN_EXPS, "weight", il), { n_ff_exp, n_embd, n_expert }, expert_flags);
+        create_tensor_gate_up_exps(layer, il, n_embd, n_ff_exp, n_expert, expert_flags);
 
         layer.ffn_gate_inp_shexp = create_tensor(tn(LLM_TENSOR_FFN_GATE_INP_SHEXP, "weight", il), { n_embd }, flags);
         layer.ffn_gate_shexp     = create_tensor(tn(LLM_TENSOR_FFN_GATE_SHEXP,     "weight", il), { n_embd, n_ff_shexp }, flags);
