+void ggml_backend_sched_get_expert_pool_stats(
+        const ggml_backend_sched_t sched,
+        long long * hits,
+        long long * misses) {
+    if (hits != NULL) {
+        *hits = 0;
+    }
+    if (misses != NULL) {
+        *misses = 0;
+    }
+    if (sched == NULL) {
+        return;
+    }
+    for (const auto & ep : sched->expert_pools) {
+        if (hits != NULL) {
+            *hits += (long long) ep.n_hits;
+        }
+        if (misses != NULL) {
+            *misses += (long long) ep.n_misses;
+        }
+    }
+}
