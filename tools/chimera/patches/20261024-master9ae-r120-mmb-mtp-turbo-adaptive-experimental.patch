+++ b/cloud9/tests/test-cloud9-turboquant-port.py
@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+checks = {
+    "ggml/include/ggml.h": ["GGML_TYPE_TURBO3_0", "GGML_TYPE_TURBO4_0", "GGML_TYPE_TURBO2_0"],
+    "ggml/src/ggml-vulkan/vulkan-shaders/types.glsl": ["block_turbo3_0", "block_turbo4_0"],
+    "ggml/src/ggml-vulkan/vulkan-shaders/flash_attn_dequant.glsl": ["GGML_TYPE_TURBO3_0", "GGML_TYPE_TURBO4_0"],
+    "tools/llama-bench/llama-bench.cpp": ["turbo3", "turbo4"],
+}
+missing = []
+for rel, needles in checks.items():
+    text = (root / rel).read_text(errors="replace")
+    for needle in needles:
+        if needle not in text:
+            missing.append(f"{rel}: {needle}")
+if missing:
+    raise SystemExit("Missing Cloud9 TurboQuant port:\n" + "\n".join(missing))
+print("Cloud9 TurboQuant port markers present")
