diff --git a/cloud9/tests/test-turboquant-abi.py b/cloud9/tests/test-turboquant-abi.py
new file mode 100755
index 0000000..592073d
--- /dev/null
+++ b/cloud9/tests/test-turboquant-abi.py
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+import re, sys
+from pathlib import Path
+p = Path(sys.argv[1])
+s = p.read_text()
+want = {
+    'GGML_TYPE_Q2_0': 42,
+    'GGML_TYPE_TURBO3_0': 43,
+    'GGML_TYPE_TURBO4_0': 44,
+    'GGML_TYPE_TURBO2_0': 45,
+    'GGML_TYPE_COUNT': 46,
+}
+for name, value in want.items():
+    m = re.search(rf'\b{name}\s*=\s*(\d+)', s)
+    if not m:
+        print(f'MISSING={name}')
+        raise SystemExit(1)
+    got = int(m.group(1))
+    if got != value:
+        print(f'ABI_MISMATCH={name}:got={got}:want={value}')
+        raise SystemExit(1)
+print('TURBOQUANT_ABI=PASS')
diff --git a/cloud9/tests/test-turboquant-cache-types.sh b/cloud9/tests/test-turboquant-cache-types.sh
