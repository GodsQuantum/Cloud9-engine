# Cloud9 Engine runtime configuration
CLOUD9_ENGINE_HOME=$HOME/.local/share/cloud9-engine
CLOUD9_ENGINE_BACKEND=auto
# Optional model used by the local hardware promotion gate.
# CLOUD9_ENGINE_GATE_MODEL=/models/your-model.gguf
# Optional draft model sidecar.
# CLOUD9_ENGINE_GATE_DRAFT=/models/your-draft.gguf
# Minimum acceptable ratio against the currently promoted backend.
CLOUD9_ENGINE_MIN_RATIO=0.97

# Hardware-aware RADV defaults. Set off to pass only your own llama-server flags.
CLOUD9_ENGINE_RDNA_TUNING=auto
CLOUD9_ENGINE_RDNA_PROFILE=balanced
