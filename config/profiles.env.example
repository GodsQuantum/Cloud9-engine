# Cloud9 Engine low-level fallback routing and RDNA tuning.
#
# Normal production traffic goes through cloud9-model-router + config/model-catalog.json.
# The model router selects upstream-pym / upstream-fast / upstream-next /
# upstream-latest / Prism per model. Atomic is laboratory-only and must never
# become an automatic fallback on the Radeon 780M.
CLOUD9_ENGINE_BACKEND=auto

# These two values are only fallbacks for direct cloud9-llama-server use.
# The generic current/upstream symlink points to the validated fast upstream.
CLOUD9_ENGINE_GENERAL_BACKEND=upstream-fast
CLOUD9_ENGINE_MTP_BACKEND=upstream-fast

# auto = apply the validated RADV profile only on AMD/RADV.
CLOUD9_ENGINE_RDNA_TUNING=auto
# balanced (default), prefill, decode, off
CLOUD9_ENGINE_RDNA_PROFILE=balanced

# Explicit laboratory overrides only:
# CLOUD9_ENGINE_BACKEND=prism
# CLOUD9_ENGINE_BACKEND=atomic
