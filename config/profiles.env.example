# Cloud9 Engine routing and RDNA tuning.
CLOUD9_ENGINE_BACKEND=auto
# The hardware gate writes the measured winner locally. Upstream is the safe fallback.
CLOUD9_ENGINE_GENERAL_BACKEND=upstream
CLOUD9_ENGINE_MTP_BACKEND=upstream
# auto = apply the validated RADV profile only on AMD/RADV.
CLOUD9_ENGINE_RDNA_TUNING=auto
# balanced (default), prefill, decode, off
CLOUD9_ENGINE_RDNA_PROFILE=balanced
# CLOUD9_ENGINE_BACKEND=atomic
# CLOUD9_ENGINE_BACKEND=upstream
