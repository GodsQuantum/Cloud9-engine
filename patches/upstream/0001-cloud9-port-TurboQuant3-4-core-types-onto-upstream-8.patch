diff --git a/cloud9/tests/test-turboquant-cache-types.sh b/cloud9/tests/test-turboquant-cache-types.sh
new file mode 100755
index 000000000..307175166
--- /dev/null
+++ b/cloud9/tests/test-turboquant-cache-types.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euo pipefail
+BIN="${1:?usage: $0 /path/to/llama-cli}"
+shift || true
+HELP="$($BIN --help 2>&1)"
+for type in "${@:-turbo3 turbo4}"; do
+  if ! grep -qw "$type" <<<"$HELP"; then
+    echo "MISSING_CACHE_TYPE=$type"
+    exit 1
+  fi
+done
+echo TURBO_CACHE_TYPES=PASS
