From 534cda00e2abbebcab51af1a07a22a9535d732cc Mon Sep 17 00:00:00 2001
From: Cloud9 Engine <cloud9-engine@users.noreply.github.com>
Date: Wed, 16 Sep 2026 14:02:09 +0200
Subject: [PATCH] cloud9: tune RDNA3 UMA Vulkan MMID for sparse MoE

---
 cloud9/tests/test-phoenix-mmid-tile.py | 14 ++++++++++++++
 ggml/src/ggml-vulkan/ggml-vulkan.cpp   | 15 ++++++++++++---
 2 files changed, 26 insertions(+), 3 deletions(-)
 create mode 100644 cloud9/tests/test-phoenix-mmid-tile.py

diff --git a/cloud9/tests/test-phoenix-mmid-tile.py b/cloud9/tests/test-phoenix-mmid-tile.py
new file mode 100644
index 000000000..a95113796
--- /dev/null
+++ b/cloud9/tests/test-phoenix-mmid-tile.py
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+from pathlib import Path
+p=Path("ggml/src/ggml-vulkan/ggml-vulkan.cpp")
+s=p.read_text()
+needles=[
+ "cloud9_phoenix_mmid",
+ "device->architecture == AMD_RDNA3",
+ "device->uma",
+ "{ 128, 128, 32, 32",
+ "{ 128, 32, 1 }",
+]
+miss=[x for x in needles if x not in s]
+if miss: raise SystemExit("missing Phoenix MMID tuning: "+", ".join(miss))
+print("PHOENIX_MMID_SOURCE_GATE=PASS")
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 2933b5e8b..8ec79ab40 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -5069,10 +5069,16 @@ static void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         // Intel coopmat1 pins each pipeline's required subgroup size to its warptile WARP element.
         const bool cm1_pin = device->vendor_id == VK_VENDOR_ID_INTEL;
 
-        // Intel coopmat1 uses a dedicated large-tile config for quant matmul_id.
+        // Device-specific large-tile config for quant matmul_id.
         std::vector<vk_tile_config> tc_mmq_id = tc_mmq;
+        const bool cloud9_phoenix_mmid = device->vendor_id == VK_VENDOR_ID_AMD &&
+                                         device->architecture == AMD_RDNA3 && device->uma &&
+                                         device->driver_id != vk::DriverId::eAmdProprietary;
         if (cm1_pin) {
             tc_mmq_id[2] = { { 512, 128, 128, 32, 32, 32, 2, device->coopmat_m, device->coopmat_n, device->coopmat_k, 32 }, { 128, 128, 1 }, 32 };
+        } else if (cloud9_phoenix_mmid) {
+            // Phoenix/Hawk Point RDNA3 UMA: high-aspect MMID tile for sparse MoE expert batches.
+            tc_mmq_id[2] = { { 128, 128, 32, 32, subgroup_size_8, 32, 2, device->coopmat_m, device->coopmat_n, device->coopmat_k, subgroup_size_8 }, { 128, 32, 1 }, 128 };
         }
 
         auto cm1_create = [&](vk_matmul_pipeline_key key, const std::vector<vk_tile_config>& tc_base,
@@ -7360,14 +7366,17 @@ static vk_device ggml_vk_get_device(size_t idx) {
         for (uint32_t i = 0; i < GGML_TYPE_COUNT; ++i) {
             switch (device->vendor_id) {
 #ifndef GGML_VULKAN_RUN_TESTS
-            case VK_VENDOR_ID_AMD:
+            case VK_VENDOR_ID_AMD: {
                 device->mul_mat_l[i]    = device->coopmat_support && device->driver_id != vk::DriverId::eAmdProprietary;
                 device->mul_mat_m[i]    = true;
                 device->mul_mat_s[i]    = true;
-                device->mul_mat_id_l[i] = false;
+                const bool cloud9_phoenix_mmid = device->architecture == AMD_RDNA3 && device->uma &&
+                                                 device->coopmat_support && device->driver_id != vk::DriverId::eAmdProprietary;
+                device->mul_mat_id_l[i] = cloud9_phoenix_mmid;
                 device->mul_mat_id_m[i] = true;
                 device->mul_mat_id_s[i] = true;
                 break;
+            }
             case VK_VENDOR_ID_INTEL: {
                 // Current Windows driver does not expose BF16 support.
                 // We only want to use l_warptile if coopmat is available
-- 
