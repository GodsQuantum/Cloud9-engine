+// TurboQuant signed WHT composed from upstream ops: D2 * H * D1.
+struct test_turbo_wht : public test_case {
+    const int group_size;
+    const int64_t ne0;
+
+    std::string vars() override { return VARS_TO_STR2(group_size, ne0); }
+    double max_nmse_err() override { return 1e-6; }
+
+    test_turbo_wht(int group_size, int64_t ne0) : group_size(group_size), ne0(ne0) {}
+
+    ggml_tensor * apply(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * rot,
+                        ggml_tensor * first, ggml_tensor * second) {
+        cur = ggml_mul(ctx, cur, first);
+        const auto old_ne = std::array<int64_t, 4>{cur->ne[0], cur->ne[1], cur->ne[2], cur->ne[3]};
+        cur = ggml_reshape_2d(ctx, cur, group_size, ggml_nelements(cur) / group_size);
+        cur = ggml_mul_mat(ctx, rot, cur);
+        ggml_mul_mat_set_hint(cur, GGML_HINT_SRC0_IS_HADAMARD);
+        cur = ggml_reshape_4d(ctx, cur, old_ne[0], old_ne[1], old_ne[2], old_ne[3]);
+        return ggml_mul(ctx, cur, second);
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * a = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, ne0, 3, 2, 1);
+        ggml_tensor * s1 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, group_size);
+        ggml_tensor * s2 = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, group_size);
+        ggml_tensor * rot = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, group_size, group_size);
+        ggml_set_param(a); ggml_set_param(s1); ggml_set_param(s2); ggml_set_param(rot);
+        ggml_set_name(a, "a"); ggml_set_name(s1, "tq_s1"); ggml_set_name(s2, "tq_s2"); ggml_set_name(rot, "tq_h");
+        ggml_tensor * fwd = apply(ctx, a, rot, s1, s2);
+        return apply(ctx, fwd, rot, s2, s1);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "a") == 0) {
+                init_tensor_uniform(t);
+            } else if (strcmp(t->name, "tq_s1") == 0 || strcmp(t->name, "tq_s2") == 0) {
+                const float * src = strcmp(t->name, "tq_s1") == 0 ? ggml_turbo_wht_signs1() : ggml_turbo_wht_signs2();
+                ggml_backend_tensor_set(t, src, 0, group_size * sizeof(float));
+            } else if (strcmp(t->name, "tq_h") == 0) {
+                std::vector<float> h(group_size * group_size);
+                const float scale = 1.0f / sqrtf((float) group_size);
+                for (int64_t r = 0; r < group_size; ++r) for (int64_t c = 0; c < group_size; ++c) {
+                    unsigned long long v = (unsigned long long) r & (unsigned long long) c;
+                    int pop = 0; while (v) { pop += v & 1U; v >>= 1U; }
+                    h[r*group_size + c] = (pop & 1) ? -scale : scale;
+                }
+                ggml_backend_tensor_set(t, h.data(), 0, h.size() * sizeof(float));
+            }
+        }
+    }
+
+    std::string op_desc(ggml_tensor * t) override { GGML_UNUSED(t); return "TURBO_WHT_COMPOSED"; }
+};
