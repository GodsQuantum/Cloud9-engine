+static inline bool llama_is_turbo_type(ggml_type type) {
+    return type == GGML_TYPE_TURBO2_0 || type == GGML_TYPE_TURBO3_0 || type == GGML_TYPE_TURBO4_0;
+}
+
+static inline ggml_tensor * llama_turbo_wht(
+        ggml_context * ctx, ggml_tensor * cur, ggml_tensor * rot,
+        ggml_tensor * signs1, ggml_tensor * signs2, bool inverse) {
+    GGML_ASSERT(rot && signs1 && signs2);
+    GGML_ASSERT(rot->type == GGML_TYPE_F32 && signs1->type == GGML_TYPE_F32 && signs2->type == GGML_TYPE_F32);
+    GGML_ASSERT(rot->ne[0] == rot->ne[1] && (rot->ne[0] == 64 || rot->ne[0] == 128));
+    GGML_ASSERT(cur->ne[0] % rot->ne[0] == 0);
+    ggml_tensor * first  = inverse ? signs2 : signs1;
+    ggml_tensor * second = inverse ? signs1 : signs2;
+    cur = ggml_mul(ctx, cur, first);
+    cur = llama_mul_mat_hadamard(ctx, cur, rot);
+    return ggml_mul(ctx, cur, second);
+}
+
