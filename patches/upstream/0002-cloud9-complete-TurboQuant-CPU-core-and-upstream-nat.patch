+++ b/cloud9/tests/test-turboquant-kv-contract.py
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import sys
+root=Path(sys.argv[1] if len(sys.argv)>1 else '.')
+checks={
+ 'src/llama-kv-cache.cpp':[
+  'n_embd_k_gqa_eff', 'n_embd_v_gqa_eff', 'head_k_eff', 'head_v_eff',
+  'k_needs_pad', 'v_needs_pad', 'int32_t wht_group = 128',
+ ],
+ 'src/llama-graph.cpp':[
+  'llama_turbo_wht(ctx0, q, inp->self_turbo_rot',
+  'llama_turbo_wht(ctx0, cur, inp->self_turbo_rot',
+ ],
+}
+missing=[]
+for rel, needles in checks.items():
+ s=(root/rel).read_text()
+ for n in needles:
+  if n not in s: missing.append(f'{rel}:{n}')
+for m in missing: print('MISSING='+m)
+if missing: raise SystemExit(1)
+print('TURBOQUANT_KV_CONTRACT=PASS')
diff --git a/cloud9/tests/test-turboquant-wht-contract.py b/cloud9/tests/test-turboquant-wht-contract.py
new file mode 100755
index 000000000..c3e52cdce
--- /dev/null
+++ b/cloud9/tests/test-turboquant-wht-contract.py
@@ -0,0 +1,22 @@
+#!/usr/bin/env python3
+from pathlib import Path
+checks = {
+    "ggml/include/ggml.h": ["ggml_turbo_wht_signs1(", "ggml_turbo_wht_signs2("],
+    "ggml/src/ggml-turbo-quant.c": ["ggml_turbo_wht_signs1(", "ggml_turbo_wht_signs2("],
+    "src/llama-impl.h": ["llama_turbo_wht("],
+}
+failed = False
+for name, needles in checks.items():
+    text = Path(name).read_text()
+    for needle in needles:
+        if needle not in text:
+            print(f"MISSING={name}:{needle}")
+            failed = True
+# We intentionally do not add a fork-only graph op: keep upstream GGML/RPC ABI.
+for name in ("ggml/include/ggml.h", "ggml/src/ggml.c"):
+    if "GGML_OP_TURBO_WHT" in Path(name).read_text():
+        print(f"FORBIDDEN={name}:GGML_OP_TURBO_WHT")
+        failed = True
+if failed:
+    raise SystemExit(1)
+print("TURBOQUANT_WHT_CONTRACT=PASS")
